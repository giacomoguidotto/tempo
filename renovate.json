{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:all",
    "schedule:weekends"
  ],
  "labels": ["deps"],
  "rangeStrategy": "bump",
  "automerge": true,
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "reviewersFromCodeOwners": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Expo SDK pins these — auto-fixed by expo-fix.yml workflow on Renovate PRs",
      "matchFileNames": ["app/package.json"],
      "matchPackageNames": [
        "expo",
        "react",
        "react-dom",
        "react-native",
        "typescript",
        "@babel/core",
        "@types/react",
        "@types/react-dom",
        "@types/jest",
        "babel-preset-expo",
        "eslint-config-expo",
        "jest",
        "jest-expo",
        "metro",
        "@sentry/react-native",
        "@shopify/flash-list",
        "@shopify/react-native-skia",
        "@stripe/stripe-react-native",
        "lottie-react-native",
        "/^expo-/",
        "/^@expo\\//",
        "/^react-native-/",
        "/^@react-native[^/]*\\//"
      ],
      "enabled": false
    },
    {
      "description": "Pinned — newer versions break react-native-css serialization",
      "matchPackageNames": ["lightningcss"],
      "enabled": false
    }
  ]
}
