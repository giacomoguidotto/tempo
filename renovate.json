{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:all",
    "schedule:weekends"
  ],
  "labels": ["deps"],
  "rangeStrategy": "bump",
  "automerge": true,
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Expo SDK pins these — bump via `bunx expo install --fix` on SDK upgrades",
      "matchFileNames": ["app/package.json"],
      "matchPackageNames": [
        "expo",
        "react",
        "react-native",
        "/^expo-/",
        "/^@expo\\//",
        "/^react-native-/",
        "/^@react-native(-community)?\\//"
      ],
      "enabled": false
    }
  ]
}
