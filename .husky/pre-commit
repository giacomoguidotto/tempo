#!/bin/sh
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

formattable=$(printf '%s\n' "$staged" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs|json|jsonc|css)$' || true)
[ -z "$formattable" ] && exit 0

pre_hash=$(git diff --cached | sha256sum | cut -d' ' -f1)

# shellcheck disable=SC2086
# Word-splitting is intentional; project paths contain no spaces.
bun x ultracite fix $formattable

printf '%s\n' "$formattable" | while IFS= read -r file; do
  [ -f "$file" ] && git add "$file"
done

post_hash=$(git diff --cached | sha256sum | cut -d' ' -f1)
[ "$pre_hash" != "$post_hash" ] && echo "✨ Files formatted by Ultracite"

exit 0
