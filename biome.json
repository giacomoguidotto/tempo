{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!node_modules",
      "!.expo",
      "!dist",
      "!build",
      "!android",
      "!ios",
      "!**/global.css",
      "!**/app.json"
    ]
  },
  "overrides": [
    {
      "includes": ["**/metro.config.js", "**/plugins/*.js", "app/index.js"],
      "assist": { "enabled": false },
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off"
      },
      "style": {
        "noIncrementDecrement": "off",
        "useConsistentMethodSignatures": "off",
        "useDestructuring": "off"
      },
      "suspicious": {
        "noEqualsToNull": "off",
        "noUnnecessaryConditions": "off",
        "noShadow": "off",
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "off",
        "organizeImports": "on",
        "useSortedAttributes": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "extends": ["ultracite/biome/core"]
}
